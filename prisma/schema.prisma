generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())

  users     User[]
  feedback  Feedback[]
  themes    Theme[]
  reports   Report[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  workspaceId  String

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  reports      Report[]

  @@index([workspaceId])
}

model Feedback {
  id             String          @id @default(cuid())
  content        String
  channel        String
  sourceRef      String?
  customerLabel  String?
  sentiment      Sentiment?
  sentimentScore Float?
  status         FeedbackStatus  @default(NEW)
  createdAt      DateTime        @default(now())
  workspaceId    String

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbackThemes FeedbackTheme[]
  embedding      Embedding?

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, channel])
}

model Theme {
  id             String          @id @default(cuid())
  name           String
  description    String?
  color          String?
  workspaceId    String

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbackThemes FeedbackTheme[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float?

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
  @@index([themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     Unsupported("vector")

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(cuid())
  title       String
  periodStart DateTime
  periodEnd   DateTime
  contentJson Json
  createdAt   DateTime @default(now())
  workspaceId String
  generatedBy String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generator   User      @relation(fields: [generatedBy], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
}